{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mambo-jambo-photo-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "d1_databases": [
    { "binding": "DB", "database_name": "mambo-jambo-photos", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "mambo-jambo-photos" }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "http://127.0.0.1:4173",
    "MATCH_THRESHOLD": "0.62"
  }
}
