{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mambo-jambo-photo-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  // Every 10 minutes the Worker's `scheduled` handler runs the deep health check, whose HEAD ping
  // keeps the Hugging Face face service warm (see worker.js). The same tick checks the indexing
  // queue for a stall and alerts the crew once per incident — one cadence covers both, and the
  // optional alert settings (ALERT_WEBHOOK_URL, RESEND_API_KEY + ALERT_EMAIL_TO, ALERT_EMAIL_FROM,
  // ALERT_WEBHOOK_FORMAT, QUEUE_STALL_MINUTES) are secrets/vars set outside this file:
  // docs/runbook.md sections 2 and 7.
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mambo-jambo-photos",
      "database_id": "8dde58b7-fcb4-4420-9249-96c057011fe1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "mambo-jambo-photos"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://mambo-jambo-photos.vercel.app,https://photos.surfersofindia.com",
    "MATCH_THRESHOLD": "0.62",
    "BURST_GAP_SECONDS": "2",
    "APPEARANCE_THRESHOLD": "0.85",
    "FACE_API_URL": "https://ankitkotian-mambo-jambo-face-api.hf.space/extract",
    "CASHFREE_ENV": "production"
  },
  "queues": {
    "producers": [
      {
        "binding": "INDEX_QUEUE",
        "queue": "mambo-jambo-face-indexing"
      }
    ],
    "consumers": [
      {
        "queue": "mambo-jambo-face-indexing",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        // Three photos index in parallel: W1-B confirmed the Space handles three concurrent /extract
        // calls with inference_workers: 2 (the third queues briefly inside the Space, which is fine).
        "max_concurrency": 3
      }
    ]
  }
}
